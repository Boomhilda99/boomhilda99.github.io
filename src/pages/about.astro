---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="About | Oliver"
  description="Learn more about Oliver and his programming interests."
>
  <Navbar />

  <main class="content-page">
    <header class="page-header">
      <p class="eyebrow">About me</p>
      <h1>I'm Oliver.</h1>
    </header>

    <section class="about-card">
      <p>
        I'm a developer from the UK who enjoys building desktop programs,
        games, websites and custom Linux tools.
      </p>

      <p>
        I currently work with Rust, Python, C++, Astro, QML and Roblox
        development. I enjoy learning by making complete projects and solving
        the problems I encounter along the way.
      </p>
    </section>
  </main>

  <Footer />
</Layout>
