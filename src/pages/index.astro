---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SkillBadge from "../components/SkillBadge.astro";

const name = "Oliver";

const description =
  "I've made Roblox games, Python tools, Rust programs, Geometry Dash mods and websites.";

const skills = [
  {
    name: "Rust",
    colour: "#f74b00",
    background: "#391607",
    icon: "logos:rust",
  },
  {
    name: "Python",
    colour: "#ccaa2e",
    background: "#3e3410",
    icon: "logos:python",
  },
  {
    name: "C++",
    colour: "#659ad1",
    background: "#10273f",
    icon: "logos:c-plusplus",
  },
  {
    name: "Roblox",
    colour: "#bfbfbf",
    background: "#444444",
    icon: "simple-icons:roblox",
  },
];
---

<Layout title={`${name}'s Portfolio`} description={description}>
  <Navbar />

  <main class="hero">
    <p class="eyebrow">Developer portfolio</p>

    <h1>Hi, I'm <span>{name}.</span></h1>

    <div class="hero-content">
      <h2>I make projects in:</h2>

      <div class="skills">
        {
          skills.map((skill) => (
            <SkillBadge {...skill} />
          ))
        }
      </div>

      <p class="description">{description}</p>

      <a href="/projects" class="primary-button">
        <Icon name="solar:programming-outline" width="25" height="25" />
        View my projects
        <Icon name="mdi-light:arrow-right" width="25" height="25" />
      </a>
    </div>
  </main>

  <Footer />
</Layout>
