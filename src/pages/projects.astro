---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = [
  {
    title: "Rust To-Do List",
    description:
      "A desktop task manager built with Rust and Iced, with persistent task storage.",
    image: "/images/todo-app.png",
    technologies: ["Rust", "Iced", "JSON"],
    github: "https://github.com/Boomhilda99/to-do-list-gui",
  },
  {
    title: "Portfolio Website",
    description:
      "My personal developer portfolio, built with Astro and deployed through GitHub Pages.",
    image: "/images/portfolio.png",
    technologies: ["Astro", "HTML", "CSS"],
    github: "https://github.com/Boomhilda99/boomhilda99.github.io",
    demo: "https://boomhilda99.github.io",
  },
  {
    title: "The Ultimate Game Loader",
    description:
      "A joke mod I made for Geometry Dash to learn the syntax of C++ and geode's API. It lists the number of times you've loaded up the game on the title screen.",
    image: "/images/ultimate-game-loader.png",
    technologies: ["C++", "Geode", "Geometry Dash"],
    github: "https://github.com/Boomhilda99/ultimate-game-loader",
  },
  {
    title: "QNA web-server",
    description:
      "The first time I setup a web server, and my first time I tried making styled HTML pages. This was a project I made to learn the basics of web development. My python code at the time was messy, but I learned a lot from this project.",
    image: "/images/web-server.png",
    technologies: ["Python", "Flask", "HTML", "CSS"],
    github: "https://github.com/Boomhilda99/qna-web-server",
  },
];
---

<Layout
  title="Projects | Oliver"
  description="A selection of programming projects made by Oliver."
>
  <Navbar />

  <main class="content-page">
    <header class="page-header">
      <p class="eyebrow">Selected work</p>
      <h1>Projects</h1>
      <p>A selection of things I've designed, programmed and experimented with.</p>
    </header>

    <section class="project-grid" aria-label="Projects">
      {
        projects.map((project) => (
          <ProjectCard {...project} />
        ))
      }
    </section>
  </main>

  <Footer />
</Layout>
