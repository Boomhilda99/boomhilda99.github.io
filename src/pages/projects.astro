---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = [
  {
    title: "Rust To-Do List",
    description:
      "The first Rust project I made, a simple to-do list GUI application built with the `Iced` GUI library. This project tested my knowledge of Enum types and structs, and I'm really glad at how it looks.",
    image: "/images/todo-app.png",
    technologies: ["Rust", "Iced"],
    github: "https://github.com/Boomhilda99/to-do-list-gui",
  },
  {
    title: "Portfolio Website",
    description:
      "This is the website you're currently on! I made this project to learn how to use Astro, and to make a portfolio website for myself. I learned a lot about Astro's component system, and how to use it to make a website that is both fast and easy to maintain.",
    image: "/images/portfolio.png",
    technologies: ["Astro", "HTML", "CSS"],
    github: "https://github.com/Boomhilda99/boomhilda99.github.io",
    demo: "https://boomhilda99.github.io",
  },
  {
    title: "The Ultimate Game Loader",
    description:
      "A joke mod I made for Geometry Dash to learn the syntax of C++ and geode's API. It lists the number of times you've loaded up the game on the title screen.",
    image: "/images/ultimate-game-loader.png",
    technologies: ["C++", "Geode", "Geometry Dash"],
    github: "https://github.com/Boomhilda99/The-Ultimate-Game-Loader",
  },
  {
    title: "QNA web-server",
    description:
      "The first time I setup a web server, and my first time I tried making styled HTML pages. This was a project I made to learn the basics of web development. My python code at the time was messy, but I learned a lot from this project.",
    image: "/images/web-server.png",
    technologies: ["Python", "Flask", "HTML", "CSS"],
    github: "https://github.com/Boomhilda99/web-server",
  },
  {
    title: "Survival Game",
    description:
      "I made this project as an extension of an inventory system I had already made. I thought adding survival mechanics like mining stone and damaging other people could also extend my skills. Unfortunately, I never finished this project, but I learned a lot about module scripts so I could store pickaxe damage and block drops.",
    image: "/images/survival-game.png",
    technologies: [ "Lua", "Roblox Studio"],
    roblox: "https://www.roblox.com/games/117034171401417/Survival-Game",
  },
];
---

<Layout
  title="Projects | Oliver"
  description="A selection of programming projects made by Oliver."
>
  <Navbar />

  <main class="content-page">
    <header class="page-header">
      <p class="eyebrow">Selected work</p>
      <h1>Projects</h1>
      <p>A selection of things I've designed, programmed and experimented with.</p>
    </header>

    <section class="project-grid" aria-label="Projects">
      {
        projects.map((project) => (
          <ProjectCard {...project} />
        ))
      }
    </section>
  </main>

  <Footer />
</Layout>
